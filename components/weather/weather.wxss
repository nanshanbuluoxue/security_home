/* components/weather/weather.wxss */
.container {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 15rpx;
  box-sizing: border-box;
 } 
 .weather{
  height: 110px;
  width: 100%;
  margin-bottom: 10px;
  border-radius: 5px;
  color: #FFF;
  padding: 5PX 15px;
  display: flex;
  font-size: 14px;
  box-sizing: border-box;
 }
 .weather>view{
  flex: 1;
 }
 .weather>view>view{
  margin: 5px 0;
 }
 .today{
  background-color: #30BCAF;
 }

 .location,.cond_txt{
  font-size: 14px;
 }
 .date,.tmp.hum{
  font-weight: bold;
 }
 .weather_icon{
   margin-top: 5rpx;
   margin-right: 30rpx;
  text-align: center;
  height: 130rpx;
 }
 .weather_icon image{
  width: 130rpx;
  height: 100%;
 }
 .lastUpdateDate{
  font-size: 10px;
  text-align: center;
 }