<!--pages/about/about.wxml-->
<view class="container">
  <view  class="userinfo">
    <button  class="userinfo-button" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
  <image  class="userinfo-avatar" src="{{userInfo.avatarUrl}}"></image> 
</button> 
<input type="nickname" class="userinfo-nickname" value="{{userInfo.nickName||''}}" bindchange="onInput" placeholder="请输入昵称"/>
  </view>
  <view class="login">
<view wx:if="{{!hasUserInfo}}" >
      <button wx:if="{{canIUseGetUserProfile}}" bindtap="getUserProfile" type="primary"  >登录</button>
      <button wx:else open-type="getUserInfo" bindgetuserinfo="getUserInfo"  type="primary" >登录</button>
</view>
</view>
  <view class="list-container">
  <navigator class="list-item" url="/pages/setting/setting" open-type='switchTab'>
    <text class="list-name">阈值设置</text>
    <image class="list-icon" src="/static/imags/chevron.png"></image>
  </navigator>
  <navigator class="list-item" url="/subpkg/pages/clause/clause">
    <text class="list-name">使用条款</text>
    <image class="list-icon" src="/static/imags/chevron.png"></image>
  </navigator>
  <navigator class="list-item" url="/subpkg/pages/help/help">
    <text class="list-name">软件说明</text>
    <image class="list-icon" src="/static/imags/chevron.png"></image>
  </navigator>
  <navigator class="list-item" url="/subpkg/pages/feedback/feedback">
    <text class="list-name">用户反馈</text>
    <image class="list-icon" src="/static/imags/chevron.png"></image>
  </navigator>
  </view>
</view>

