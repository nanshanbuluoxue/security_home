/* subpkg/pages/feedback/feedback.wxss */
.container {
  padding: 20rpx;
}

.feedback-form {
  width: 100%;
}

.feedback-input {
  width: 100%;
  height: 200rpx;
  padding: 10rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #ccc;
  border-radius: 5rpx;
}

.submit-button {
  width: 100%;
  height: 80rpx;
  background-color: #007bff;
  color: #fff;
  border: none;
  border-radius: 5rpx;
  font-size: 16px;
}

.submit-button:hover {
  background-color: #0056b3;
}
